{
	"name": "mailster-woocommerce",
	"version": "2.0.2",
	"description": "WooCommerce integration for Mailster.",
	"author": "Xaver",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"woocommerce",
		"mailster",
		"newsletter",
		"email"
	],
	"homepage": "https://mailster.co",
	"repository": {
		"type": "git",
		"url": "https://github.com/everpress-co/mailster-woocommerce.git"
	},
	"bugs": {
		"url": "https://github.com/everpress-co/mailster-woocommerce/issues"
	},
	"private": true,
	"wp-env": {
		"plugin-dir": "mailster-woocommerce",
		"plugin-name": "Mailster WooCommerce"
	},
	"files": [
		"*.php",
		"build",
		"classes",
		"views",
		"readme.txt"
	],
	"dependencies": {
		"@wordpress/components": "^28.13.0",
		"@wordpress/compose": "^7.13.0",
		"@wordpress/core-data": "^7.13.0",
		"@wordpress/data": "^10.13.0",
		"@wordpress/element": "^6.13.0",
		"@wordpress/hooks": "^4.13.0",
		"@wordpress/i18n": "^5.13.0",
		"@wordpress/plugins": "^7.13.0",
		"react-select": "^5.2.2"
	},
	"devDependencies": {
		"@woocommerce/dependency-extraction-webpack-plugin": "^3.0.1",
		"@wordpress/scripts": "^36.1.0"
	},
	"scripts": {
		"build": "wp-scripts build",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js src",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start",
		"lint": "npm run lint:css && npm run lint:pkg-json",
		"lint:pkg-json": "wp-scripts lint-pkg-json"
	}
}
